#!/bin/sh
# build-wayfire <prefix> - build our from-source Wayland compositor stack into
# <prefix> and install it there: wlroots (clean upstream) -> wayfire (+ our
# patches) -> wcm / wayfire-plugins-extra / wf-info (clean) + filters / pixdecor
# (+ our patches) + our own plugins. The whole recipe, reused by
# `setup.sh install` (prefix = /opt/wayfire, sudo) and `setup.sh verify`
# (prefix = a throwaway dir, no sudo), so the real build and CI take the SAME
# path.
#
# rpath: every installed ELF carries a DT_RUNPATH of <prefix>/lib/<arch>
# (LDFLAGS at meson setup, kept through install), so the prefix is self-
# contained with no ld.so.conf entry. A build-time gate at the end fails loud if
# any ELF lacks it. wlroots' vendored wraps and wayfire's own subproject libs
# are forced to rebuild from source (their stale prefix .pc removed first), so
# they too pick up the rpath rather than shadow it with a pre-installed copy.
#
# INCREMENTAL: each component skips when its install artifact is present AND its
# stamp (its pinned ref, plus the wayfire stage's own stamp, which covers the
# wlroots/wayfire refs AND our wayfire patches, plus local patch/plugin
# content) is unchanged. Stamps live in the package cache, so a
# converged prefix is a seconds-long no-op. Set WBM_NOSTAMP=1 (verify does) to
# never record a stamp, so a throwaway build cannot make a real build skip.
#
# Needs: git, meson, ninja, gcc/g++, and the wlroots/wayfire build libs (the
# consumer declares those). Fails loud via meson if a lib is missing.
set -eu

: "${WBM_ROOT:?WBM_ROOT (the wayfire-mods repo root) must be set}"

# THE BUILD ID: one hash of everything that decides what this checkout
# installs (the refs, this recipe, every patch and plugin file). Written into
# the prefix after a FULLY successful build and compared by `setup.sh check`,
# so an install that is not this checkout's (stale, or one that died half
# way) reads as a failure rather than "wayfire is installed". `--build-id`
# prints it without building, for that check.
build_id() {
  { cat "$WBM_ROOT/refs" "$WBM_ROOT/libexec/build-wayfire"
    find "$WBM_ROOT/patches" "$WBM_ROOT/plugins" -type f | LC_ALL=C sort \
      | while IFS= read -r _f; do printf '%s\n' "${_f#"$WBM_ROOT"/}"
        cat "$_f"; done
  } | cksum | awk '{print $1"-"$2}'
}
if [ "${1:-}" = --build-id ]; then
  build_id
  exit 0
fi

PREFIX=${1:?usage: build-wayfire <prefix> | --build-id}
. "$WBM_ROOT/refs"
# Taken BEFORE building: the id names the inputs this run actually used,
# even if the checkout changes while it compiles.
BUILD_ID=$(build_id)

CACHE=${WBM_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/wayfire-mods}
# Every tree this recipe removes (build dirs, the bundled wlroots) sits under
# CACHE, which comes from the environment: check it once before any of them.
case $CACHE in
/*/*) ;;
*) echo "build: refusing a cache root of '$CACHE'" >&2; exit 1 ;;
esac
SRC=$CACHE/srcs
STAMPS=$CACHE/stamps
JOBS=$(nproc 2>/dev/null || echo 4)
ARCH=$(cc -dumpmachine 2>/dev/null || gcc -dumpmachine 2>/dev/null \
       || echo x86_64-linux-gnu)
LIBDIR=$PREFIX/lib/$ARCH
PATCHES=$WBM_ROOT/patches
PLUGINS=$WBM_ROOT/plugins

# Anonymous public clones: keep a login user's insteadOf-ssh git identity from
# turning these https clones into ssh ones that die on a fresh box.
export GIT_CONFIG_GLOBAL=/dev/null
# Chain every later build onto the prefix we are populating, and ONLY that
# prefix: the caller's PKG_CONFIG_PATH is dropped, not appended. A session
# that exports another wayfire's pkgconfig (drydock's env prepends
# /opt/wayfire's, so plugins can be built against it) otherwise makes meson
# find THAT wf-config and skip building its own, and a throwaway prefix then
# holds a wayfire that cannot load (libwf-config.so.1 not found; measured on
# manifold 2026-11-01, verify broke at the first login with that env).
# System packages still resolve: pkg-config searches its default dirs anyway.
export PKG_CONFIG_PATH="$LIBDIR/pkgconfig:$PREFIX/share/pkgconfig"

mkdir -p "$CACHE" "$SRC" "$STAMPS"
cd "$CACHE"   # meson realpaths the CWD; keep it a dir that exists

# Decide privilege from the target: a writable (or creatable) prefix is the
# user's; anything else is a system prefix that must go under sudo.
SUDO=sudo
if [ -w "$PREFIX" ]; then SUDO=""
elif [ ! -e "$PREFIX" ] && mkdir -p "$PREFIX" 2>/dev/null; then SUDO=""
fi
[ -z "$SUDO" ] || sudo mkdir -p "$PREFIX"

say() { printf '\n\033[1m== %s ==\033[0m\n' "$*"; }

# --- incremental gating -----------------------------------------------------
hash_of() { cksum | awk '{print $1"-"$2}'; }
pin() { printf '%s\n' "$@" | hash_of; }
in_sync() {   # <name> <want> <artifact>  -> 0 (skip) if built and current
  [ -e "$3" ] && [ -r "$STAMPS/$1.stamp" ] \
    && [ "$(cat "$STAMPS/$1.stamp" 2>/dev/null)" = "$2" ]
}
mark() {   # <name> <want>: WBM_NOSTAMP (verify) never records
  [ -n "${WBM_NOSTAMP:-}" ] && return 0
  printf '%s\n' "$2" > "$STAMPS/$1.stamp"
}

fetch() {   # <name> <url> <ref>  -> populate $SRC/<name> at <ref>
  _n=$1; _u=$2; _r=$3; _d=$SRC/$_n
  [ -d "$_d/.git" ] || git clone --recurse-submodules "$_u" "$_d"
  git -C "$_d" fetch --tags --no-recurse-submodules --force origin
  git -C "$_d" checkout -f "$_r"
  git -C "$_d" submodule update --init --recursive
}

# pristine <srcdir> <ref>: back to exactly <ref> before patches re-apply.
# reset alone keeps UNTRACKED files, so a file a patch CREATED on the last run
# survives it and the next `git apply` refuses to create it again. clean -fd
# (not -x, not -ff) removes those and leaves ignored files and submodules.
pristine() {
  git -C "$1" reset --hard "$2" >/dev/null
  git -C "$1" clean -fdq
}

build() {   # <srcdir> [meson args...]  -> install into $PREFIX
  _dir=$1; shift
  _tag=${_dir#"$SRC"/}; _tag=${_tag#"$PLUGINS"}; _tag=${_tag:-plugins}
  _bdir=$SRC/_build/$(printf '%s' "$_tag" | tr / -)
  rm -rf -- "$_bdir"
  LDFLAGS="-Wl,-rpath,$LIBDIR${LDFLAGS:+ $LDFLAGS}" \
    meson setup "$_bdir" "$_dir" --prefix="$PREFIX" \
      -Dwerror=false -Dc_args=-Wno-error -Dcpp_args=-Wno-error "$@"
  ninja -C "$_bdir" -j "$JOBS"
  $SUDO meson install -C "$_bdir"
}

staged() {   # <name> <want> <artifact> <src> <url> <ref> [meson args...]
  _sn=$1; _sw=$2; _sa=$3; _ss=$4; _su=$5; _sr=$6; shift 6
  if in_sync "$_sn" "$_sw" "$_sa"; then echo "  $_sn in sync ($_sr)"; return 0
  fi
  fetch "$_ss" "$_su" "$_sr"; build "$SRC/$_ss" "$@"; mark "$_sn" "$_sw"
}

# _patched <name> <artifact> <src> <url> <ref> <patch>...: fetch, reset to
# pristine, apply each patch (fail loud on drift), build -Dbuildtype=release.
# The pin folds in every patch's content, so editing a patch forces a rebuild.
_patched() {
  _pn=$1; _pa=$2; _ps=$3; _pu=$4; _pr=$5; shift 5
  _pw=$(pin "$_pr" "$WAYFIRE_STAMP" \
    "$(for _p in "$@"; do cat "$PATCHES/$_p"; done)")
  if in_sync "$_pn" "$_pw" "$_pa"; then echo "  $_pn in sync ($_pr)"; return 0
  fi
  fetch "$_ps" "$_pu" "$_pr"
  pristine "$SRC/$_ps" "$_pr"
  for _p in "$@"; do
    ( cd "$SRC/$_ps" && git apply --check "$PATCHES/$_p" \
        && git apply "$PATCHES/$_p" ) || {
      echo "build: $_p did not apply ($_ps drift from $_pr?)" >&2; return 1; }
  done
  build "$SRC/$_ps" -Dbuildtype=release
  mark "$_pn" "$_pw"
}

# --- wlroots: clean upstream, standalone ------------------------------------
say "wlroots $WLROOTS_REF (clean upstream)"
_w=$(pin "$WLROOTS_REF")
if in_sync wlroots "$_w" "$LIBDIR/libwlroots-0.20.so"; then
  echo "  wlroots in sync ($WLROOTS_REF)"
else
  fetch wlroots "$WLROOTS_URL" "$WLROOTS_REF"
  # wlroots vendors libdisplay-info/libliftoff as wraps (apt's are too old); a
  # stale prefix .pc shadows the wrap, so drop it to force a rebuild with rpath.
  for _pc in libdisplay-info libliftoff; do
    $SUDO rm -f "$LIBDIR/pkgconfig/$_pc.pc"
  done
  build "$SRC/wlroots" -Dxwayland=enabled -Dexamples=false
  mark wlroots "$_w"
fi

# --- wayfire: our patches ----------------------------------------------------
say "wayfire $WAYFIRE_REF (+ our patches)"
# The ONE list of wayfire patches, in apply order: the stamp and the apply
# loop both read it, so a patch cannot be applied without forcing a rebuild.
WAYFIRE_PATCHES="wayfire-ipc-guard-dialog-output wayfire-startup-image
  wayfire-scale-clamp wayfire-security-context-allowlist
  wayfire-xdg-activation-sandbox wayfire-diag-focus-surface
  wayfire-ipc-security-context"
_w=$(pin "$WAYFIRE_REF" "$WLROOTS_REF" \
  "$(for _p in $WAYFIRE_PATCHES; do cat "$PATCHES/$_p.patch"; done)")
# Everything below builds AGAINST this wayfire, and our patches can change
# its installed headers (a struct gaining a base class moves every member),
# so each later stamp folds in this one, not just the two refs. Otherwise a
# patch edit rebuilds wayfire and leaves a plugin compiled against the old
# layout: undefined behaviour at runtime, not an error.
WAYFIRE_STAMP=$_w
if in_sync wayfire "$_w" "$PREFIX/bin/wayfire"; then
  echo "  wayfire in sync ($WAYFIRE_REF)"
else
  fetch wayfire "$WAYFIRE_URL" "$WAYFIRE_REF"
  pristine "$SRC/wayfire" "$WAYFIRE_REF"
  for _p in $WAYFIRE_PATCHES; do
    ( cd "$SRC/wayfire" && git apply --check "$PATCHES/$_p.patch" \
        && git apply "$PATCHES/$_p.patch" ) || {
      echo "build: $_p did not apply (wayfire drift from $WAYFIRE_REF?)" >&2
      exit 1; }
  done
  # Use the standalone wlroots above, not wayfire's bundled subproject.
  rm -rf -- "$SRC/wayfire/subprojects/wlroots"
  # Force wayfire's own vendored subproject libs to rebuild (drop their stale
  # prefix .pc so meson does not resolve them externally and skip the rebuild).
  for _pc in wf-config wf-utils wf-touch wf-json; do
    $SUDO rm -f "$LIBDIR/pkgconfig/$_pc.pc"
  done
  build "$SRC/wayfire"
  mark wayfire "$_w"
fi

# --- wcm / plugins-extra: clean upstream ------------------------------------
say "wcm $WCM_REF"
staged wcm "$(pin "$WCM_REF" "$WAYFIRE_STAMP")" \
  "$PREFIX/bin/wcm" wcm "$WCM_URL" "$WCM_REF"

say "wayfire-plugins-extra $PLUGINS_EXTRA_REF (clean upstream)"
# Since 0.11.2 plugins-extra can pull pixdecor and filters in as UNPATCHED
# wraps. Off by default upstream; pinned off here, because both are built
# below with our patches and the same .so name would be overwritten by
# whichever installed last.
staged plugins-extra \
  "$(pin "$PLUGINS_EXTRA_REF" "$WAYFIRE_STAMP")" \
  "$LIBDIR/wayfire/libwater.so" \
  plugins-extra "$PLUGINS_EXTRA_URL" "$PLUGINS_EXTRA_REF" \
  -Dpixdecor=false -Dfilters=false

# --- our own plugins ---------------------------------------------------------
say "custom plugins (edge-flipping, workspace-wallpaper, wsync, atlas, ...)"
_w=$( { printf '%s\n' "$WAYFIRE_STAMP"; \
        find "$PLUGINS" -type f \( -name '*.cpp' -o -name '*.hpp' \
          -o -name '*.h' -o -name '*.xml' -o -name 'meson.build' \) \
          | sort | xargs cat; } | hash_of )
if in_sync plugins-custom "$_w" "$LIBDIR/wayfire/libedge-flipping.so"; then
  echo "  custom plugins in sync"
else
  build "$PLUGINS"
  mark plugins-custom "$_w"
fi

# --- filters / pixdecor: our patches; wf-info: clean ------------------------
say "filters $FILTERS_REF (+ our patch)"
_patched filters "$LIBDIR/wayfire/libfilters.so" filters \
  "$FILTERS_URL" "$FILTERS_REF" filters-frame-margins.patch

say "wf-info $WF_INFO_REF"
staged wf-info "$(pin "$WF_INFO_REF" "$WAYFIRE_STAMP")" \
  "$PREFIX/bin/wf-info" wf-info "$WF_INFO_URL" "$WF_INFO_REF"

say "pixdecor $PIXDECOR_REF (+ our patch)"
_patched pixdecor "$LIBDIR/wayfire/libpixdecor.so" pixdecor \
  "$PIXDECOR_URL" "$PIXDECOR_REF" pixdecor-titlebar-padding.patch

# --- assert the prefix is self-contained by rpath ---------------------------
_missing=0
_sos=$(find "$LIBDIR" -name '*.so*' -type f 2>/dev/null)
for _f in "$PREFIX"/bin/* $_sos; do
  [ -f "$_f" ] || continue
  readelf -h "$_f" >/dev/null 2>&1 || continue
  if ! readelf -d "$_f" 2>/dev/null | grep -E 'RUNPATH|RPATH' \
       | grep -qF "$LIBDIR"; then
    echo "  MISSING rpath: $_f"; _missing=1
  fi
done
[ "$_missing" = 0 ] || { echo "prefix not self-contained by rpath"; exit 1; }
# Only now, with every component built and the rpath gate passed: the id is
# the claim "this prefix is that checkout", so it must not exist for a run
# that stopped early.
$SUDO mkdir -p "$PREFIX/share/wayfire-mods"
printf '%s\n' "$BUILD_ID" \
  | $SUDO tee "$PREFIX/share/wayfire-mods/build-id" > /dev/null
echo "wayfire-mods: compositor stack built + installed -> $PREFIX"
echo "wayfire-mods: build id $BUILD_ID"
