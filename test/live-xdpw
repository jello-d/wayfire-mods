#!/bin/sh
# live-xdpw <backend> <wayland display> <scratch dir> [consumer]: drive one
# xdg-desktop-portal-wlr against a display, on the PRIVATE session bus this
# runs under (live.t starts it inside dbus-run-session, with a private
# pipewire in XDG_RUNTIME_DIR), and print one line per fact:
#
#   types <n>          AvailableSourceTypes (1 monitor, 2 window)
#   offered <n>        lines the chooser was handed for a WINDOW request
#   started <u>        the Start response code (0 = a stream was created)
#   streams <n>        streams Start returned
#   consumed <n>       buffers a browser-shaped consumer READ from that stream
#                      in 3s (only with [consumer], test/live-pwconsume): a
#                      stream that is created is not one anything can read
#   consume-error ...  the consumer's link was refused, or its stream failed
#   monitor <u>        the Start response after a MONITOR-only selection
#   screen <...>       what a consumer read from that monitor's stream
#   restore <yes|no>   the window share's Start reply carried restore data
#                      (the session asked to persist, as Chrome does)
#   reprompt <n>       chooser runs during a SECOND session handed that
#                      data: 0, or Chrome's real share asks the person again
#   restored <...>     what a consumer read from that restored stream
#   alive <yes|no>     the backend was still running after all of it
#   exited <rc>        the backend died before answering (and its error)
#
# The calls are the backend interface's own signatures (CreateSession is
# o o s a{sv}, Start o o s s a{sv}): a wrong one creates no session, and the
# backend then crashes on SelectSources, which reads as the patch failing.
#
# The chooser is a script that records what it was offered and picks the
# first WINDOW line (the first MONITOR line for the monitor-only request),
# so the test sees exactly what a human would have been shown.
# It also counts its runs, which is how a restore that silently re-prompts is
# told from one that does not.
set -u
bin=$1; disp=$2; d=$3; consumer=${4:-}
B=org.freedesktop.impl.portal.desktop.wlr
O=/org/freedesktop/portal/desktop
I=org.freedesktop.impl.portal.ScreenCast
# What it picks is read from <scratch>/pick at each run: the backend starts
# the chooser with its own environment, so a variable set on the call would
# never reach it. Every run APPENDS to <scratch>/offered. The window pick is
# WINDOW_PICK (a grep pattern, default the first window): a share of a window
# that never changes yields one frame, which reads exactly like a stalled
# stream, so live.t names a window that keeps drawing.
printf '%s\n' '#!/bin/sh' "d=$d" 'echo run >> "$d/runs"' \
  'pick=$(cat "$d/pick" 2>/dev/null) || pick="^Window: "' \
  'tee -a "$d/offered" | grep -m 1 "$pick"' > "$d/chooser"
chmod +x "$d/chooser"
printf '[screencast]\nchooser_type=dmenu\nchooser_cmd=%s/chooser\n' "$d" \
  > "$d/xdpw.conf"
# NO SESSION MANAGER: the consumer links itself to the node Start returned
# (see test/live-pwconsume.c for why a session manager's policy is the
# wrong judge of a format question).
WAYLAND_DISPLAY=$disp "$bin" -l INFO -c "$d/xdpw.conf" > "$d/xdpw.log" 2>&1 &
p=$!
_i=0
until busctl --user status "$B" > /dev/null 2>&1; do
  if ! kill -0 "$p" 2>/dev/null; then
    wait "$p"; echo "exited $? $(grep -m 1 ERROR "$d/xdpw.log")"; exit 0
  fi
  _i=$((_i + 1)); [ "$_i" -lt 50 ] || { echo "exited timeout"; kill "$p"
    exit 0; }
  sleep 0.1
done
_t=$(busctl --user get-property "$B" "$O" "$I" AvailableSourceTypes)
echo "types ${_t#u }"
call() { busctl --user --timeout=10 call "$B" "$O" "$I" "$@" 2>&1; }
_sess() {   # <n>: a fresh session handle pair
  call CreateSession oosa{sv} "/req/c$1" "/s/s$1" live 0 > /dev/null
}
printf '%s\n' "${WINDOW_PICK:-^Window: }" > "$d/pick"
_sess 1
call SelectSources oosa{sv} /req/w1 /s/s1 live 2 types u 2 \
  persist_mode u 1 > /dev/null
_st=$(call Start oossa{sv} /req/st1 /s/s1 live '' 0)
_n=0; [ -f "$d/offered" ] && _n=$(grep -c . "$d/offered")
echo "offered $_n"
echo "started $(printf '%s\n' "$_st" | awk '{print $2}')"
case $_st in
  *streams*) echo "streams $(printf '%s\n' "$_st" \
    | sed -n 's/.*"streams" a(ua{sv}) \([0-9]*\).*/\1/p')" ;;
  *) echo "streams 0" ;;
esac
# The node id is the field after the stream count.
_node=$(printf '%s\n' "$_st" \
  | sed -n 's/.*"streams" a(ua{sv}) [0-9]* \([0-9]*\) .*/\1/p')
if [ -n "$consumer" ] && [ -n "$_node" ]; then
  _c=$("$consumer" "$_node" 3 2>/dev/null)
  case $_c in error*|refused*) echo "consume-error ${_c#* }" ;;
    *) echo "${_c:-consumed none}" ;; esac
fi
_sess 2
echo '^Monitor: ' > "$d/pick"     # the chooser runs inside SelectSources
call SelectSources oosa{sv} /req/m2 /s/s2 live 1 types u 1 > /dev/null
printf '%s\n' "${WINDOW_PICK:-^Window: }" > "$d/pick"
_m=$(call Start oossa{sv} /req/st2 /s/s2 live '' 0)
echo "monitor $(printf '%s\n' "$_m" | awk '{print $2}')"
_mn=$(printf '%s\n' "$_m" \
  | sed -n 's/.*"streams" a(ua{sv}) [0-9]* \([0-9]*\) .*/\1/p')
if [ -n "$consumer" ] && [ -n "$_mn" ]; then
  echo "screen $("$consumer" "$_mn" 3 2>/dev/null)"
fi
# THE RESTORE: Chrome previews through one session and shares through a
# second, carrying the first one's restore data so nobody is asked twice.
_id=$(printf '%s\n' "$_st" \
  | sed -n 's/.*"toplevel_identifier" s "\([^"]*\)".*/\1/p')
if [ -n "$_id" ]; then
  echo "restore yes"
  _r0=$(grep -c . "$d/runs" 2>/dev/null) || _r0=0
  _sess 3
  call SelectSources oosa{sv} /req/w3 /s/s3 live 3 types u 2 \
    persist_mode u 1 restore_data '(suv)' wlroots 1 a{sv} 1 \
    toplevel_identifier s "$_id" > /dev/null
  _s3=$(call Start oossa{sv} /req/st3 /s/s3 live '' 0)
  _r1=$(grep -c . "$d/runs" 2>/dev/null) || _r1=0
  echo "reprompt $((_r1 - _r0))"
  _n3=$(printf '%s\n' "$_s3" \
    | sed -n 's/.*"streams" a(ua{sv}) [0-9]* \([0-9]*\) .*/\1/p')
  if [ -n "$consumer" ] && [ -n "$_n3" ]; then
    echo "restored $("$consumer" "$_n3" 3 2>/dev/null)"
  else
    echo "restored none"
  fi
else
  echo "restore no"
fi
if kill -0 "$p" 2>/dev/null; then echo "alive yes"; kill "$p"
else echo "alive no"; fi
wait "$p" 2>/dev/null
exit 0
