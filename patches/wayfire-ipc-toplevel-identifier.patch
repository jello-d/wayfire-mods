diff --git a/plugins/common/wayfire/plugins/common/toplevel-identifier.hpp b/plugins/common/wayfire/plugins/common/toplevel-identifier.hpp
new file mode 100644
index 00000000..c87e41ce
--- /dev/null
+++ b/plugins/common/wayfire/plugins/common/toplevel-identifier.hpp
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <string>
+#include <wayfire/object.hpp>
+
+namespace wf
+{
+namespace toplevel_identifier
+{
+/**
+ * The ext-foreign-toplevel-list-v1 identifiers a window currently has, stored
+ * on the view by the plugin that owns the lists (under DATA_NAME) for as long
+ * as its handles exist. A window can sit on more than one list, and each
+ * handle carries its OWN identifier, so they are kept apart:
+ *
+ * - personal: the handle on the list clients outside any security context
+ *   see.
+ * - instance: the handle on the list of the window's own security-context
+ *   instance, which is the identifier a sandboxed client of that instance
+ *   sees. Empty when the window is not sandboxed.
+ */
+struct identifiers_t : public wf::custom_data_t
+{
+    std::string personal;
+    std::string instance;
+};
+
+inline constexpr const char *DATA_NAME = "toplevel-identifier";
+}
+}
diff --git a/plugins/ipc-rules/ipc-rules-common.hpp b/plugins/ipc-rules/ipc-rules-common.hpp
index 337a544b..6623bfe1 100644
--- a/plugins/ipc-rules/ipc-rules-common.hpp
+++ b/plugins/ipc-rules/ipc-rules-common.hpp
@@ -1,6 +1,7 @@
 #pragma once
 #include "wayfire/plugins/common/shared-core-data.hpp"
 #include "wayfire/plugins/common/security-context.hpp"
+#include "wayfire/plugins/common/toplevel-identifier.hpp"
 #include "wayfire/plugins/ipc/ipc-helpers.hpp"
 #include "wayfire/plugins/ipc/ipc-method-repository.hpp"
 #include <wayfire/output.hpp>
@@ -216,12 +217,30 @@ static inline wf::json_t view_to_json(wayfire_view view)
     // through. ABSENT for a client outside any context, PRESENT (possibly with
     // empty fields, when the sandbox engine set none) for one inside: three
     // states, so "unsandboxed" is never confused with "sandboxed, unnamed".
+    // The window's ext-foreign-toplevel-list-v1 identifiers, when a plugin
+    // publishes them: "toplevel-identifier" is the one clients outside any
+    // security context see, and security-context's own "toplevel-identifier"
+    // the one the window's instance sees. Each list handle has its own, so a
+    // sandboxed client and the owner join on the instance one. ABSENT while
+    // no list holds the window.
+    auto ids = view->get_data<wf::toplevel_identifier::identifiers_t>(
+        wf::toplevel_identifier::DATA_NAME);
+    if (ids && !ids->personal.empty())
+    {
+        description["toplevel-identifier"] = ids->personal;
+    }
+
     if (auto ctx = wf::security_context::lookup_client(view->get_client()))
     {
         wf::json_t sc;
         sc["sandbox-engine"] = ctx->sandbox_engine;
         sc["app-id"]      = ctx->app_id;
         sc["instance-id"] = ctx->instance_id;
+        if (ids && !ids->instance.empty())
+        {
+            sc["toplevel-identifier"] = ids->instance;
+        }
+
         description["security-context"] = sc;
     }
 
