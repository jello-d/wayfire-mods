+// wayfire-mods (ipc-name-dropped-client): who is on the other end of FD, as
+// "pid N (name)", asked only once a send has failed. SO_PEERCRED is the peer
+// as it connected; its name is /proc/<pid>/comm, "?" if it has gone.
+static std::string describe_peer(int fd)
+{
+    struct ucred cred;
+    socklen_t len = sizeof(cred);
+    if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &len) != 0)
+    {
+        return "(peer unknown)";
+    }
+
+    std::string comm = "?";
+    std::ifstream f("/proc/" + std::to_string(cred.pid) + "/comm");
+    if (!std::getline(f, comm) || comm.empty())
+    {
+        comm = "?";
+    }
+
+    return "pid " + std::to_string(cred.pid) + " (" + comm + ")";
+}
