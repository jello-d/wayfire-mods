 #include "logger.h"
 #include "fps_limit.h"
 
+/*
+ * Whether to capture through ext-image-copy-capture. Upstream requires the
+ * OUTPUT source manager, so a compositor offering only the per-window
+ * (foreign-toplevel) source cannot start at all, which is exactly what a
+ * sandboxed client that may share its own windows but never a whole screen
+ * sees. Take the ext path when either source manager is present, but prefer
+ * wlr-screencopy over window-only ext when the compositor offers it, so a
+ * compositor upstream could already serve keeps upstream's path unchanged.
+ */
+static bool xdpw_ext_ic_usable(const struct xdpw_screencast_context *ctx) {
+	if (!ctx->ext_image_copy_capture_manager) {
+		return false;
+	}
+	if (ctx->ext_output_image_capture_source_manager) {
+		return true;
+	}
+	return ctx->ext_foreign_toplevel_image_capture_source_manager
+		&& !ctx->screencopy_manager;
+}
