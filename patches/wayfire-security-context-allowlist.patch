--- /dev/null
+++ b/plugins/common/wayfire/plugins/common/security-context.hpp
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+#include <wayfire/signal-provider.hpp>
+#include <wayfire/plugins/common/shared-core-data.hpp>
+
+struct wl_client;
+
+namespace wf
+{
+namespace security_context
+{
+/**
+ * The metadata a client's security context was committed with (see the
+ * security-context-v1 protocol). Each field is empty when the context did not
+ * set it.
+ */
+struct context_info_t
+{
+    std::string sandbox_engine;
+    std::string app_id;
+    std::string instance_id;
+};
+
+/**
+ * on: registry_t
+ * when: A sandbox engine committed a new security context, before any client
+ *   can connect through it. A plugin that keeps per-context state (one global
+ *   per sandbox instance, say) creates it here, so it exists by the time the
+ *   sandboxed clients bind.
+ */
+struct context_committed_signal
+{
+    context_info_t info;
+};
+
+/**
+ * Shared between plugins with wf::shared_data::ref_ptr_t<registry_t>. The
+ * security-context-v1 plugin fills it in while it is loaded: `lookup`, every
+ * context committed so far (`committed`, for a plugin loaded later), and
+ * emits context_committed_signal for each new one.
+ */
+struct registry_t : public wf::signal::provider_t
+{
+    std::function<std::optional<context_info_t>(const wl_client*)> lookup;
+    std::vector<context_info_t> committed;
+};
+
+/**
+ * The security context @client connected through, or std::nullopt if it did
+ * not connect through one (or the security-context-v1 plugin is not loaded).
+ */
+inline std::optional<context_info_t> lookup_client(const wl_client *client)
+{
+    wf::shared_data::ref_ptr_t<registry_t> registry;
+    if (!registry->lookup || !client)
+    {
+        return std::nullopt;
+    }
+
+    return registry->lookup(client);
+}
+}
+}
