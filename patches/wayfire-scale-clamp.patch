 float round_scale_to_1_120(float scale)
 {
+    // Floor output scale at 1: never downscale. A scale < 1 enlarges the
+    // logical space past the panel, so the compositor downsamples -> soft,
+    // bit-mashed text; scale 1 is native/crisp (the fixed-pixel UI is sized
+    // for the design panel; wb templates the bar per panel, not shrink it).
+    // The floor also fixes a crash: with use_external_output_configuration
+    // = true a new output takes scale 0 from the yet-unapplied kanshi head,
+    // and wlroots asserts scale > 0 -> SIGABRT on the first surface. Scale
+    // >= 1 (a genuine HiDPI 2x panel) passes through unchanged.
+    if (scale < 1.0f)
+    {
+        scale = 1.0f;
+    }
     int numerator = std::round(scale * 120);
     return numerator / 120.0f;
 }
