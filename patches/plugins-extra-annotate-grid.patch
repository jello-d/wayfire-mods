+    void destroy_node(std::shared_ptr<simple_node_t> node)
+    {
+        overlay_destroy(node->overlay);
+        overlay_destroy(node->shape_overlay);
+        wf::scene::remove_child(node);
+    }
+
+    /*
+     * The workspace grid can change at runtime (core/vwidth and vheight set
+     * over IPC, or a config reload). Keep exactly one overlay per workspace
+     * of the CURRENT grid: a cell that survives keeps its drawing, a removed
+     * one is dropped, a new one starts empty. Without this, a grid grown
+     * after init() was indexed past the table built there, which aborts.
+     * Called on every grid change, and before every use of the table, since
+     * a workspace set swapped onto the output brings its own grid.
+     */
+    void sync_grid()
+    {
+        auto wsize = output->wset()->get_workspace_grid_size();
+        bool same  = ((int)overlays.size() == wsize.width);
+        for (auto& column : overlays)
+        {
+            same &= ((int)column.size() == wsize.height);
+        }
+
+        if (same)
+        {
+            return;
+        }
+
+        for (int x = 0; x < (int)overlays.size(); x++)
+        {
+            for (int y = 0; y < (int)overlays[x].size(); y++)
+            {
+                if ((x >= wsize.width) || (y >= wsize.height))
+                {
+                    destroy_node(overlays[x][y]);
+                }
+            }
+        }
+
+        auto og = output->get_relative_geometry();
+        auto vp = output->wset()->get_current_workspace();
+        overlays.resize(wsize.width);
+        for (int x = 0; x < wsize.width; x++)
+        {
+            int had = std::min((int)overlays[x].size(), wsize.height);
+            overlays[x].resize(wsize.height);
+            for (int y = had; y < wsize.height; y++)
+            {
+                overlays[x][y] = add_simple_node(output, (x - vp.x) * og.width,
+                    (y - vp.y) * og.height, og.width, og.height);
+            }
+        }
+    }
+
+    wf::signal::connection_t<wf::workspace_grid_changed_signal> grid_changed =
+        [=] (wf::workspace_grid_changed_signal*)
+    {
+        sync_grid();
+        output->render->damage_whole();
+    };
+
     std::shared_ptr<simple_node_t> get_node_overlay()
     {
+        sync_grid();
         auto ws = output->wset()->get_current_workspace();
         return overlays[ws.x][ws.y];
     }
 
